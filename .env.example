# ============================================================
# Supabase — Settings > API στο dashboard του project σου
# ============================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Resend — API Keys στο dashboard
# ============================================================
RESEND_API_KEY=
# Πρέπει να είναι verified domain/sender στο Resend. Για τεστ
# μπορείς να χρησιμοποιήσεις onboarding@resend.dev (στέλνει μόνο
# στο δικό σου λογαριασμό μέχρι να επαληθεύσεις domain).
RESEND_FROM_EMAIL="House Rentals <onboarding@resend.dev>"

# ============================================================
# Admin panel
# ============================================================
# Ο κωδικός για να μπαίνεις στο /pages/admin.html
ADMIN_PASSWORD=
# Τυχαίο μυστικό string (π.χ. 32+ τυχαίοι χαρακτήρες) για την
# υπογραφή του session cookie. Δημιούργησέ το μία φορά και μην
# το μοιραστείς.
ADMIN_SESSION_SECRET=

# ============================================================
# Unsubscribe links — τυχαίο μυστικό string, διαφορετικό από το
# ADMIN_SESSION_SECRET, για την υπογραφή των unsubscribe tokens.
# ============================================================
UNSUBSCRIBE_SECRET=

# ============================================================
# Στοιχεία επικοινωνίας — χρησιμοποιούνται μέσα στα emails.
# Μία πηγή αλήθειας, ώστε να μην είναι hardcoded σε πολλά σημεία.
# ============================================================
SITE_URL=https://your-site.netlify.app
CONTACT_PHONE="+30 210 0000000"
CONTACT_EMAIL=info@example.com
# Προαιρετικό — αν μείνει κενό, δεν εμφανίζεται στα emails.
CONTACT_BOOKING_URL=
